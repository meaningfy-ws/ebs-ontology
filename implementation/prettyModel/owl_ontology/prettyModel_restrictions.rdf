    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:imports rdf:resource="http://example.com/ex#prettyModel"/>
    <dcterms:title xml:lang="en">prettyModel restrictions</dcterms:title>
    <rdfs:label xml:lang="en">prettyModel — restrictions</rdfs:label>
    <dcterms:publisher>https://example.com/publisher</dcterms:publisher>
    <dcterms:description xml:lang="en">This artefact provides the restrictions and inference-related specifications for the prettyModel demonstration ontology.
        This artefact excludes the definitions of concepts.
        prettyModel is a sample non-ePO UML conceptual model used to exercise the model2owl transformation pipeline in CI.</dcterms:description>
