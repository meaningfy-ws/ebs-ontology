    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://ebs-integrator.com/ontology/erp#worksOnProject> ?that . ?that <http://ebs-integrator.com/ontology/erp#worksOnProject> ?this .}" ] .

core-shape:ebs-EmployeePlannedTime-ebs-concernsEmployee a sh:PropertyShape ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:class ebs:Employee ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Concerns employee" ;
    sh:path ebs:concernsEmployee ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://ebs-integrator.com/ontology/erp#concernsEmployee> ?that . ?that <http://ebs-integrator.com/ontology/erp#concernsEmployee> ?this .}" ] .

core-shape:ebs-EmployeePlannedTime-ebs-concernsProject a sh:PropertyShape ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:class ebs:Project ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Concerns project" ;
    sh:path ebs:concernsProject ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://ebs-integrator.com/ontology/erp#concernsProject> ?that . ?that <http://ebs-integrator.com/ontology/erp#concernsProject> ?this .}" ] .

