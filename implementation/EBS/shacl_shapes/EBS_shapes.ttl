    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://ebs-integrator.com/ontology/erp#hasProjectStart> ?that . ?that <http://ebs-integrator.com/ontology/erp#hasProjectStart> ?this .}" ] .

