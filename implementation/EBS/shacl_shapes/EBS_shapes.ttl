    rdfs:isDefinedBy core-shape:core-shape ;
    sh:class time:Duration ;
    sh:maxCount 1 ;
    sh:name "Has planned billable time" ;
    sh:path ebs:hasPlannedBillableTime ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://ebs-integrator.com/ontology/erp#hasPlannedBillableTime> ?that . ?that <http://ebs-integrator.com/ontology/erp#hasPlannedBillableTime> ?this .}" ] .

