@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix core-shape: <http://ebs-integrator.com/ontology/erp/data-shape#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ebs: <http://ebs-integrator.com/ontology/erp#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix person: <http://www.w3.org/ns/person#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

core-shape:adms-IdentifierShape a sh:NodeShape ;
    rdfs:label "Identifier" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:property core-shape:adms-Identifier-skos-notation ;
    sh:targetClass adms:Identifier .

core-shape:ebs-AgentInRoleShape a sh:NodeShape ;
    rdfs:label "Agent In Role" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:property core-shape:ebs-AgentInRole-adms-identifier,
        core-shape:ebs-AgentInRole-dcterms-title,
        core-shape:ebs-AgentInRole-ebs-playedBy ;
    sh:targetClass ebs:AgentInRole .

core-shape:ebs-CapacityShape a sh:NodeShape ;
    rdfs:label "Capacity" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:property core-shape:ebs-Capacity-ebs-concernsMonth ;
    sh:targetClass ebs:Capacity .

core-shape:ebs-CompanyShape a sh:NodeShape ;
    rdfs:label "Company" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:property core-shape:ebs-Company-ebs-employs,
        core-shape:ebs-Company-ebs-hasEfficiencyRate,
        core-shape:ebs-Company-ebs-hasMonthlyCapacity ;
    sh:targetClass ebs:Company .

core-shape:ebs-EfficiencyShape a sh:NodeShape ;
    rdfs:label "Efficiency" ;
    rdfs:comment "Not sure if an efficiency class is needed." ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:property core-shape:ebs-Efficiency-ebs-forInterval ;
    sh:targetClass ebs:Efficiency .

core-shape:ebs-EmployeePlannedTimeShape a sh:NodeShape ;
    rdfs:label "Employee Planned Time" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:property core-shape:ebs-EmployeePlannedTime-ebs-concernsEmployee,
        core-shape:ebs-EmployeePlannedTime-ebs-concernsProject,
        core-shape:ebs-EmployeePlannedTime-ebs-hasPlannedBillableTime,
        core-shape:ebs-EmployeePlannedTime-ebs-hasPlannedNonBillableTime ;
    sh:targetClass ebs:EmployeePlannedTime .

core-shape:ebs-EmployeeShape a sh:NodeShape ;
    rdfs:label "Employee" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:property core-shape:ebs-Employee-ebs-hasCapacity,
        core-shape:ebs-Employee-ebs-hasEfficiencyRate,
        core-shape:ebs-Employee-ebs-hasRecordedBillTime,
        core-shape:ebs-Employee-ebs-hasRecordedNonBillTime,
        core-shape:ebs-Employee-ebs-hasReplacementPipeline,
        core-shape:ebs-Employee-ebs-hasSalary,
        core-shape:ebs-Employee-ebs-hasSeniority,
        core-shape:ebs-Employee-ebs-isActive,
        core-shape:ebs-Employee-ebs-memberOf,
        core-shape:ebs-Employee-ebs-worksOnProject ;
    sh:targetClass ebs:Employee .

core-shape:ebs-ExternalProjectShape a sh:NodeShape ;
    rdfs:label "External Project" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:targetClass ebs:ExternalProject .

core-shape:ebs-FixedPriceProjectShape a sh:NodeShape ;
    rdfs:label "Fixed Price Project" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:targetClass ebs:FixedPriceProject .

core-shape:ebs-HolidayProjectShape a sh:NodeShape ;
    rdfs:label "Holiday Project" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:targetClass ebs:HolidayProject .

core-shape:ebs-InternalProjectShape a sh:NodeShape ;
    rdfs:label "Internal Project" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:targetClass ebs:InternalProject .

core-shape:ebs-InvestmentProjectShape a sh:NodeShape ;
    rdfs:label "Investment Project" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:targetClass ebs:InvestmentProject .

core-shape:ebs-MonetaryValueShape a sh:NodeShape ;
    rdfs:label "Monetary Value" ;
    rdfs:comment "Equivalent to epo:Monetary value." ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:property core-shape:ebs-MonetaryValue-ebs-hasAmountValue,
        core-shape:ebs-MonetaryValue-ebs-hasCurrency ;
    sh:targetClass ebs:MonetaryValue .

core-shape:ebs-OperationsProjectShape a sh:NodeShape ;
    rdfs:label "Operations Project" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:targetClass ebs:OperationsProject .

core-shape:ebs-ProjectManagerShape a sh:NodeShape ;
    rdfs:label "Project Manager" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:property core-shape:ebs-ProjectManager-ebs-managesProject ;
    sh:targetClass ebs:ProjectManager .

core-shape:ebs-ProjectShape a sh:NodeShape ;
    rdfs:label "Project" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:property core-shape:ebs-Project-ebs-hasAssociatedTaskList,
        core-shape:ebs-Project-ebs-hasCommercialRate,
        core-shape:ebs-Project-ebs-hasEfficiencyRate,
        core-shape:ebs-Project-ebs-hasProjectEnd,
        core-shape:ebs-Project-ebs-hasProjectStart,
        core-shape:ebs-Project-ebs-hasTotalPlannedBillableTime,
        core-shape:ebs-Project-ebs-hasTotalPlannedNonBillableTime,
        core-shape:ebs-Project-ebs-isActive ;
    sh:targetClass ebs:Project .

core-shape:ebs-RateShape a sh:NodeShape ;
    rdfs:label "Rate" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:property core-shape:ebs-Rate-ebs-hasMonetaryValue ;
    sh:targetClass ebs:Rate .

core-shape:ebs-RoleShape a sh:NodeShape ;
    rdfs:label "Role" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:targetClass ebs:Role .

core-shape:ebs-SalaryShape a sh:NodeShape ;
    rdfs:label "Salary" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:property core-shape:ebs-Salary-ebs-concernsMonth,
        core-shape:ebs-Salary-ebs-hasMonetaryValue ;
    sh:targetClass ebs:Salary .

core-shape:ebs-StackShape a sh:NodeShape ;
    rdfs:label "Stack" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:property core-shape:ebs-Stack-ebs-hasEfficiencyRate ;
    sh:targetClass ebs:Stack .

core-shape:ebs-TandMProjectShape a sh:NodeShape ;
    rdfs:label "Tand M Project" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:targetClass ebs:TandMProject .

core-shape:ebs-TaskListShape a sh:NodeShape ;
    rdfs:label "Task List" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:targetClass ebs:TaskList .

core-shape:ebs-TeamLeadShape a sh:NodeShape ;
    rdfs:label "Team Lead" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:property core-shape:ebs-TeamLead-ebs-PlansTime,
        core-shape:ebs-TeamLead-ebs-leads ;
    sh:targetClass ebs:TeamLead .

core-shape:ebs-TeamShape a sh:NodeShape ;
    rdfs:label "Team" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:property core-shape:ebs-Team-ebs-hasEfficiencyRate,
        core-shape:ebs-Team-ebs-worksOnStack ;
    sh:targetClass ebs:Team .

core-shape:org-OrganizationShape a sh:NodeShape ;
    rdfs:label "Organization" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:property core-shape:org-Organization-adms-identifier,
        core-shape:org-Organization-dcterms-title ;
    sh:targetClass org:Organization .

core-shape:person-PersonShape a sh:NodeShape ;
    rdfs:label "Person" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:property core-shape:person-Person-foaf-firstName,
        core-shape:person-Person-foaf-lastName ;
    sh:targetClass person:Person .

core-shape:time-DurationShape a sh:NodeShape ;
    rdfs:label "Duration" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:property core-shape:time-Duration-time-numericDuration,
        core-shape:time-Duration-time-unitType ;
    sh:targetClass time:Duration .

core-shape:time-InstantShape a sh:NodeShape ;
    rdfs:label "Instant" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:property core-shape:time-Instant-time-inXSDDate,
        core-shape:time-Instant-time-inXSDDateTimeStamp ;
    sh:targetClass time:Instant .

core-shape:time-IntervalShape a sh:NodeShape ;
    rdfs:label "Interval" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:property core-shape:time-Interval-ebs-relatedToProject ;
    sh:targetClass time:Interval .

core-shape:time-TemporalDurationShape a sh:NodeShape ;
    rdfs:label "Temporal Duration" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:targetClass time:TemporalDuration .

core-shape:time-TemporalEntityShape a sh:NodeShape ;
    rdfs:label "Temporal Entity" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:property core-shape:time-TemporalEntity-adms-identifier,
        core-shape:time-TemporalEntity-dcterms-description,
        core-shape:time-TemporalEntity-time-hasBeginning,
        core-shape:time-TemporalEntity-time-hasDuration,
        core-shape:time-TemporalEntity-time-hasEnd ;
    sh:targetClass time:TemporalEntity .

core-shape:time-TemporalUnitShape a sh:NodeShape ;
    rdfs:label "Temporal Unit" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:targetClass time:TemporalUnit .

core-shape:adms-Identifier-skos-notation a sh:PropertyShape ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Notation" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path skos:notation .

core-shape:ebs-AgentInRole-adms-identifier a sh:PropertyShape ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:class adms:Identifier ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Identifier" ;
    sh:path adms:identifier ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://www.w3.org/ns/adms#identifier> ?that . ?that <http://www.w3.org/ns/adms#identifier> ?this .}" ] .

core-shape:ebs-AgentInRole-dcterms-title a sh:PropertyShape ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:maxCount 1 ;
    sh:name "Title" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path dcterms:title .

core-shape:ebs-AgentInRole-ebs-playedBy a sh:PropertyShape ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:class person:Person ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Played by" ;
    sh:path ebs:playedBy ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://ebs-integrator.com/ontology/erp#playedBy> ?that . ?that <http://ebs-integrator.com/ontology/erp#playedBy> ?this .}" ] .

core-shape:ebs-Capacity-ebs-concernsMonth a sh:PropertyShape ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Concerns month" ;
    sh:path ebs:concernsMonth .

core-shape:ebs-Company-ebs-employs a sh:PropertyShape ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:class ebs:Employee ;
    sh:minCount 1 ;
    sh:name "Employs" ;
    sh:path ebs:employs ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://ebs-integrator.com/ontology/erp#employs> ?that . ?that <http://ebs-integrator.com/ontology/erp#employs> ?this .}" ] .

core-shape:ebs-Company-ebs-hasEfficiencyRate a sh:PropertyShape ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:class ebs:Efficiency ;
    sh:maxCount 1 ;
    sh:name "Has efficiency rate" ;
    sh:path ebs:hasEfficiencyRate ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://ebs-integrator.com/ontology/erp#hasEfficiencyRate> ?that . ?that <http://ebs-integrator.com/ontology/erp#hasEfficiencyRate> ?this .}" ] .

core-shape:ebs-Company-ebs-hasMonthlyCapacity a sh:PropertyShape ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:class ebs:Capacity ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Has monthly capacity" ;
    sh:path ebs:hasMonthlyCapacity ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://ebs-integrator.com/ontology/erp#hasMonthlyCapacity> ?that . ?that <http://ebs-integrator.com/ontology/erp#hasMonthlyCapacity> ?this .}" ] .

core-shape:ebs-Efficiency-ebs-forInterval a sh:PropertyShape ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:class time:Interval ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "For interval" ;
    sh:path ebs:forInterval ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://ebs-integrator.com/ontology/erp#forInterval> ?that . ?that <http://ebs-integrator.com/ontology/erp#forInterval> ?this .}" ] .

core-shape:ebs-Employee-ebs-hasCapacity a sh:PropertyShape ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:class time:Duration ;
    sh:maxCount 1 ;
    sh:name "Has capacity" ;
    sh:path ebs:hasCapacity ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://ebs-integrator.com/ontology/erp#hasCapacity> ?that . ?that <http://ebs-integrator.com/ontology/erp#hasCapacity> ?this .}" ] .

core-shape:ebs-Employee-ebs-hasEfficiencyRate a sh:PropertyShape ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:class ebs:Efficiency ;
    sh:maxCount 1 ;
    sh:name "Has efficiency rate" ;
    sh:path ebs:hasEfficiencyRate ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://ebs-integrator.com/ontology/erp#hasEfficiencyRate> ?that . ?that <http://ebs-integrator.com/ontology/erp#hasEfficiencyRate> ?this .}" ] .

core-shape:ebs-Employee-ebs-hasRecordedBillTime a sh:PropertyShape ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:class time:Interval ;
    sh:name "Has recorded bill time" ;
    sh:path ebs:hasRecordedBillTime ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://ebs-integrator.com/ontology/erp#hasRecordedBillTime> ?that . ?that <http://ebs-integrator.com/ontology/erp#hasRecordedBillTime> ?this .}" ] .

core-shape:ebs-Employee-ebs-hasRecordedNonBillTime a sh:PropertyShape ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:class time:Interval ;
    sh:name "Has recorded non bill time" ;
    sh:path ebs:hasRecordedNonBillTime ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://ebs-integrator.com/ontology/erp#hasRecordedNonBillTime> ?that . ?that <http://ebs-integrator.com/ontology/erp#hasRecordedNonBillTime> ?this .}" ] .

core-shape:ebs-Employee-ebs-hasReplacementPipeline a sh:PropertyShape ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:class ebs:Project ;
    sh:name "Has replacement pipeline" ;
    sh:path ebs:hasReplacementPipeline ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://ebs-integrator.com/ontology/erp#hasReplacementPipeline> ?that . ?that <http://ebs-integrator.com/ontology/erp#hasReplacementPipeline> ?this .}" ] .

core-shape:ebs-Employee-ebs-hasSalary a sh:PropertyShape ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:class ebs:Salary ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Has salary" ;
    sh:path ebs:hasSalary ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://ebs-integrator.com/ontology/erp#hasSalary> ?that . ?that <http://ebs-integrator.com/ontology/erp#hasSalary> ?this .}" ] .

core-shape:ebs-Employee-ebs-hasSeniority a sh:PropertyShape ;
    rdfs:isDefinedBy core-shape:core-shape ;
