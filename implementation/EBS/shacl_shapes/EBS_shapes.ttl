    rdfs:isDefinedBy core-shape:core-shape ;
    sh:class ebs:TaskList ;
    sh:name "Has associated task list" ;
    sh:path ebs:hasAssociatedTaskList ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://ebs-integrator.com/ontology/erp#hasAssociatedTaskList> ?that . ?that <http://ebs-integrator.com/ontology/erp#hasAssociatedTaskList> ?this .}" ] .

