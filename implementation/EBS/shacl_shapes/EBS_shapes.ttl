    sh:maxCount 1 ;
    sh:name "Has seniority" ;
    sh:path ebs:hasSeniority .

core-shape:ebs-Employee-ebs-isActive a sh:PropertyShape ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Is active" ;
    sh:path ebs:isActive .

core-shape:ebs-Employee-ebs-memberOf a sh:PropertyShape ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:class ebs:Team ;
    sh:maxCount 1 ;
    sh:name "Member of" ;
    sh:path ebs:memberOf ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://ebs-integrator.com/ontology/erp#memberOf> ?that . ?that <http://ebs-integrator.com/ontology/erp#memberOf> ?this .}" ] .

core-shape:ebs-Employee-ebs-worksOnProject a sh:PropertyShape ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:class ebs:Project ;
