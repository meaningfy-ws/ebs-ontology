@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix at-voc: <http://publications.europa.eu/resource/authority/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ebs: <http://ebs-integrator.com/ontology/erp#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix person: <http://www.w3.org/ns/person#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ebs:core-restriction a owl:Ontology ;
    dcterms:created "2026-07-09"^^xsd:date ;
    dcterms:issued "2026-08-03"^^xsd:date ;
    dcterms:license "CC BY 4.0" ;
    dcterms:publisher "Meaningfy" ;
    dcterms:title "EBS restrictions"@en ;
    vann:preferredNamespacePrefix "ebs" ;
    vann:preferredNamespaceUri "http://ebs-integrator.com/ontology/erp#" ;
    rdfs:comment "This version is automatically generated from EBS.xml on 2026-08-03" ;
    owl:imports <http://data.europa.eu/m8g>,
        ebs:core,
        dcterms:,
        skos:,
        <http://www.w3.org/ns/adms> ;
    owl:versionIRI ebs:core-restriction-1.0.0 ;
    owl:versionInfo "1.0.0" .

ebs:hasAssociatedTaskList rdfs:domain ebs:Project ;
    rdfs:range ebs:TaskList .

ebs:hasCurrency a owl:FunctionalProperty ;
    rdfs:domain ebs:MonetaryValue ;
    rdfs:range skos:Concept .

ebs:hasRecordedBillTime rdfs:domain ebs:Employee ;
    rdfs:range time:Interval .

ebs:hasRecordedNonBillTime rdfs:domain ebs:Employee ;
    rdfs:range time:Interval .

ebs:hasReplacementPipeline rdfs:domain ebs:Employee ;
    rdfs:range ebs:Project .

ebs:hasSalary rdfs:domain ebs:Employee ;
    rdfs:range ebs:Salary .

ebs:hasSeniority rdfs:domain ebs:Employee ;
    rdfs:range skos:Concept .

ebs:worksOnProject rdfs:domain ebs:Employee ;
    rdfs:range ebs:Project .

ebs:concernsEmployee a owl:FunctionalProperty ;
    rdfs:domain ebs:EmployeePlannedTime ;
    rdfs:range ebs:Employee .

ebs:concernsProject a owl:FunctionalProperty ;
    rdfs:domain ebs:PlannedTime ;
    rdfs:range ebs:Project .

ebs:employs rdfs:domain ebs:Company ;
    rdfs:range ebs:Employee .

ebs:forInterval a owl:FunctionalProperty ;
    rdfs:domain ebs:Efficiency ;
    rdfs:range time:Interval .

ebs:hasAmountValue a owl:FunctionalProperty ;
    rdfs:domain ebs:MonetaryValue ;
    rdfs:range xsd:decimal .

ebs:hasCommercialRate rdfs:domain ebs:Project ;
    rdfs:range ebs:Rate .

ebs:hasMonthlyCapacity rdfs:domain ebs:Employee ;
    rdfs:range ebs:Capacity .

ebs:hasPlannedBillableTime rdfs:domain ebs:PlannedTime ;
    rdfs:range time:Duration .

ebs:hasPlannedNonBillableTime rdfs:domain ebs:PlannedTime ;
    rdfs:range time:Duration .

ebs:hasProjectEnd rdfs:domain ebs:Project ;
    rdfs:range time:Instant .

ebs:hasProjectStart rdfs:domain ebs:Project ;
    rdfs:range time:Instant .

ebs:hasTotalPlannedBillableTime rdfs:domain ebs:Project ;
    rdfs:range time:Duration .

ebs:hasTotalPlannedNonBillableTime rdfs:domain ebs:Project ;
    rdfs:range time:Duration .

ebs:hasValue a owl:FunctionalProperty ;
    rdfs:domain ebs:Capacity ;
    rdfs:range time:Duration .

ebs:leads a owl:FunctionalProperty ;
    rdfs:domain ebs:TeamLead ;
    rdfs:range ebs:Team .

ebs:managesProject rdfs:domain ebs:ProjectManager ;
    rdfs:range ebs:Project .

ebs:memberOf rdfs:domain ebs:Employee ;
    rdfs:range ebs:Team .

ebs:playedBy a owl:FunctionalProperty ;
    rdfs:domain ebs:AgentInRole ;
    rdfs:range person:Person .

ebs:relatedToProject a owl:FunctionalProperty ;
    rdfs:domain time:Interval ;
    rdfs:range ebs:Project .

ebs:worksOnStack a owl:FunctionalProperty ;
    rdfs:domain ebs:Team ;
    rdfs:range ebs:Stack .

at-voc:Seniority a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:Seniority ;
            owl:onProperty skos:inScheme ] .

at-voc:currency a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:currency ;
            owl:onProperty skos:inScheme ] .

dcterms:description rdfs:domain time:TemporalEntity ;
    rdfs:range rdf:PlainLiteral .

dcterms:title rdfs:domain [ a owl:Class ;
            owl:unionOf ( ebs:AgentInRole org:Organization ) ] ;
    rdfs:range rdf:PlainLiteral .

skos:notation a owl:FunctionalProperty ;
    rdfs:domain adms:Identifier ;
    rdfs:range rdf:PlainLiteral .

time:hasBeginning rdfs:domain time:TemporalEntity ;
    rdfs:range time:Instant .

time:hasDuration a owl:FunctionalProperty ;
    rdfs:domain time:TemporalEntity ;
    rdfs:range time:TemporalDuration .

time:hasEnd rdfs:domain time:TemporalEntity ;
    rdfs:range time:Instant .

time:inXSDDate rdfs:domain time:Instant ;
    rdfs:range xsd:date .

time:inXSDDateTimeStamp rdfs:domain time:Instant ;
    rdfs:range xsd:dateTimeStamp .

time:numericDuration a owl:FunctionalProperty ;
    rdfs:domain time:Duration ;
    rdfs:range xsd:decimal .

time:unitType a owl:FunctionalProperty ;
    rdfs:domain time:Duration ;
    rdfs:range time:TemporalUnit .

foaf:firstName rdfs:domain person:Person ;
    rdfs:range rdf:PlainLiteral .

foaf:lastName rdfs:domain person:Person ;
    rdfs:range rdf:PlainLiteral .

ebs:Company rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ebs:employs ;
            owl:someValuesFrom ebs:Employee ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass ebs:Efficiency ;
            owl:onProperty ebs:hasEfficiencyRate ] .

ebs:PlansTime rdfs:domain [ a owl:Class ;
            owl:unionOf ( ebs:TeamLead ebs:ProjectManager ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ebs:EmployeePlannedTime ebs:ProjectPlannedTime ) ] .

ebs:ProjectManager rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ebs:PlansTime ;
            owl:someValuesFrom ebs:ProjectPlannedTime ],
        [ a owl:Restriction ;
            owl:onProperty ebs:managesProject ;
            owl:someValuesFrom ebs:Project ] .

ebs:TeamLead rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ebs:PlansTime ;
            owl:someValuesFrom ebs:EmployeePlannedTime ],
        [ a owl:Restriction ;
            owl:onClass ebs:Team ;
            owl:onProperty ebs:leads ;
            owl:qualifiedCardinality 1 ] .

ebs:concernsMonth a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ebs:Capacity ebs:PlannedTime ebs:Salary ) ] ;
    rdfs:range time:Instant .

ebs:hasMonetaryValue a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ebs:Salary ebs:Rate ) ] ;
    rdfs:range ebs:MonetaryValue .

ebs:isActive a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ebs:Employee ebs:Project ) ] ;
    rdfs:range xsd:boolean .

org:Organization rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass adms:Identifier ;
            owl:onProperty adms:identifier ] .

ebs:AgentInRole rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adms:Identifier ;
            owl:onProperty adms:identifier ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty dcterms:title ],
        [ a owl:Restriction ;
            owl:onClass person:Person ;
            owl:onProperty ebs:playedBy ;
            owl:qualifiedCardinality 1 ] .

ebs:EmployeePlannedTime rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ebs:Employee ;
            owl:onProperty ebs:concernsEmployee ;
            owl:qualifiedCardinality 1 ] .

ebs:Rate rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ebs:MonetaryValue ;
            owl:onProperty ebs:hasMonetaryValue ;
            owl:qualifiedCardinality 1 ] .

ebs:Salary rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ebs:MonetaryValue ;
            owl:onProperty ebs:hasMonetaryValue ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onClass time:Instant ;
            owl:onProperty ebs:concernsMonth ;
            owl:qualifiedCardinality 1 ] .

ebs:Stack rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass ebs:Efficiency ;
            owl:onProperty ebs:hasEfficiencyRate ] .

adms:identifier a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ebs:AgentInRole org:Organization time:TemporalEntity ) ] ;
    rdfs:range adms:Identifier .

ebs:Capacity rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass time:Duration ;
            owl:onProperty ebs:hasValue ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onClass time:Instant ;
            owl:onProperty ebs:concernsMonth ;
            owl:qualifiedCardinality 1 ] .

ebs:PlannedTime rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ebs:Project ;
            owl:onProperty ebs:concernsProject ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onProperty ebs:hasPlannedBillableTime ;
            owl:someValuesFrom time:Duration ],
        [ a owl:Restriction ;
            owl:onProperty ebs:hasPlannedNonBillableTime ;
            owl:someValuesFrom time:Duration ] .

person:Person rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty foaf:lastName ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty foaf:firstName ] .

ebs:MonetaryValue rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty ebs:hasAmountValue ;
            owl:qualifiedCardinality 1 ] .

ebs:hasEfficiencyRate rdfs:domain [ a owl:Class ;
            owl:unionOf ( ebs:Company ebs:Employee ebs:Team ebs:Stack ebs:Project ) ] ;
    rdfs:range ebs:Efficiency .

time:Interval rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ebs:Project ;
            owl:onProperty ebs:relatedToProject ;
            owl:qualifiedCardinality 1 ] .

time:TemporalEntity rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass time:Instant ;
            owl:onProperty time:hasBeginning ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass time:Instant ;
            owl:onProperty time:hasEnd ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass adms:Identifier ;
            owl:onProperty adms:identifier ],
        [ a owl:Restriction ;
            owl:onClass time:TemporalDuration ;
            owl:onProperty time:hasDuration ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty dcterms:description ] .

adms:Identifier rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty skos:notation ;
            owl:qualifiedCardinality 1 ] .

ebs:Team rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass ebs:Efficiency ;
            owl:onProperty ebs:hasEfficiencyRate ],
        [ a owl:Restriction ;
            owl:onClass ebs:Stack ;
            owl:onProperty ebs:worksOnStack ;
            owl:qualifiedCardinality 1 ] .

ebs:Efficiency rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass time:Interval ;
            owl:onProperty ebs:forInterval ;
            owl:qualifiedCardinality 1 ] .

time:Duration rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass time:TemporalUnit ;
            owl:onProperty time:unitType ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty time:numericDuration ;
            owl:qualifiedCardinality 1 ] .

time:Instant rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange xsd:date ;
            owl:onProperty time:inXSDDate ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange xsd:dateTimeStamp ;
            owl:onProperty time:inXSDDateTimeStamp ] .

ebs:Employee rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty ebs:isActive ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass ebs:Efficiency ;
            owl:onProperty ebs:hasEfficiencyRate ],
        [ a owl:Restriction ;
            owl:onProperty ebs:hasMonthlyCapacity ;
            owl:someValuesFrom ebs:Capacity ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass ebs:Team ;
            owl:onProperty ebs:memberOf ] .

ebs:Project rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass ebs:Efficiency ;
            owl:onProperty ebs:hasEfficiencyRate ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass time:Duration ;
            owl:onProperty ebs:hasTotalPlannedBillableTime ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty ebs:isActive ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass time:Duration ;
            owl:onProperty ebs:hasTotalPlannedNonBillableTime ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass time:Instant ;
            owl:onProperty ebs:hasProjectStart ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass time:Instant ;
            owl:onProperty ebs:hasProjectEnd ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass ebs:Rate ;
            owl:onProperty ebs:hasCommercialRate ] .

